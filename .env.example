# FILE: .env.example
# PURPOSE: Root environment template for local FLASHLIVE development.
# WHY: Keeps secrets out of git while documenting required provider settings.
# HOW: Copy to .env and replace placeholders. Never commit real credentials.

DATABASE_URL=postgres://flashlive:flashlive@localhost:5432/flashlive
PORT=4000
WEB_ORIGIN=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:8080
TOKEN_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
INTERNAL_API_TOKEN=replace-with-at-least-32-random-characters
FLASHLIVE_BUILD_SLOTS=3
FLASHLIVE_ARTIFACT_DIR=../worker/artifacts

# Firebase client (web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_API_URL=http://localhost:4000

# Firebase Admin (API)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Alternative: paste the full service account JSON on one line
FIREBASE_SERVICE_ACCOUNT_JSON=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/github/callback
